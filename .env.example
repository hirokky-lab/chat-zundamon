# Optional future connection settings. Do not copy YUI credentials.
# Browser starts in display-only preview by default.
# VITE_ZUNDAMON_LOCAL_API_ENABLED=true enables this project's local API explicitly.
ZUNDAMON_MODE=local
ZUNDAMON_OPENAI_API_KEY=your-openai-api-key
ZUNDAMON_DB_PATH=./data/zundamon-ai.sqlite
ZUNDAMON_USAGE_LOG_PATH=./data/zundamon-usage.ndjson
ZUNDAMON_PORT=4384
ZUNDAMON_VOICEVOX_BASE_URL=http://127.0.0.1:50021
ZUNDAMON_VOICEVOX_STATUS_TIMEOUT_MS=2000
ZUNDAMON_VOICEVOX_QUERY_TIMEOUT_MS=5000
ZUNDAMON_VOICEVOX_SYNTHESIS_TIMEOUT_MS=15000
ZUNDAMON_WEB_SEARCH_ENABLED=false
ZUNDAMON_WEB_SEARCH_TIMEOUT_MS=15000
ZUNDAMON_CALENDAR_READ_ENABLED=false
ZUNDAMON_TASKS_READ_ENABLED=false
ZUNDAMON_CALENDAR_READ_TIMEOUT_MS=15000
ZUNDAMON_TASKS_READ_TIMEOUT_MS=15000
ZUNDAMON_ONE_TIME_REMINDER_ENABLED=false

# Hosted API project: zundamon-api (set ZUNDAMON_MODE=hosted)
# Keep every value in this section server-only.
ZUNDAMON_SUPABASE_URL=https://your-project.supabase.co
ZUNDAMON_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
ZUNDAMON_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ZUNDAMON_ALLOWED_EMAIL=your-private-login@example.com
ZUNDAMON_ALLOWED_ORIGIN=https://your-zundamon-app.example
ZUNDAMON_CRON_SECRET=your-random-cron-secret
ZUNDAMON_BACKUP_KEY=base64-encoded-32-byte-key
# Backups use the private zundamon-backups Supabase Storage bucket.
# Apply migrations first; no Vercel Blob token is required.

# Hosted Web project: zundamon-web
# These three VITE_ values are public browser configuration. Do not add server secrets here.
VITE_ZUNDAMON_SUPABASE_URL=https://your-project.supabase.co
VITE_ZUNDAMON_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_ZUNDAMON_API_BASE_URL=https://your-zundamon-api.example

# Optional self-use cost ceilings (USD)
ZUNDAMON_DAILY_MAX_USD=3
ZUNDAMON_MONTHLY_MAX_USD=10
ZUNDAMON_CHAT_MAX_USD=0.10
ZUNDAMON_MEMORY_MAX_USD=0.10
ZUNDAMON_TRANSCRIPTION_MAX_USD=0.10
ZUNDAMON_REALTIME_MAX_USD=1
ZUNDAMON_SEARCH_MAX_USD=0.10

# Drive full-search/read (separate consent and encrypted connection)
ZUNDAMON_GOOGLE_DRIVE_ENABLED=false

ZUNDAMON_GMAIL_ENABLED=false

# Optional personal Codex bridge. Requires a signed-in Codex CLI.
# Uses the owner's Codex permissions; requested work may edit files or use tools.
ZUNDAMON_CODEX_ENABLED=false
ZUNDAMON_CODEX_BINARY=codex
